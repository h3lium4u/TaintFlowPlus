# TaintFlow+ .vscodeignore — controls what goes in the VSIX

# Source TypeScript (not needed in production; compiled JS is in out/)
src/
*.ts
tsconfig.json

# Tests & dev scripts
test.js
test.py
test-vulns.js
verify.js
vuln_test.py
scripts/

# Separate deployment artifacts (not part of extension)
mcp-server/
oxp-server/
antigravity-skill/
core/
vscode-extension/

# Version control & CI
.git/
.gitignore
.github/

# IDE config dirs
.vscode/
.cursor/
.antigravity/

# Env & logs
.env
*.log
*.tmp

# Old VSIX files
*.vsix

# Markdown artifacts
*.md
vulnerabilities-report.md
antigravity_fix_prompt.md
activation_debug.log

# Test reports
test-report.txt
test-json.json

# node_modules will be bundled by vsce --no-dependencies flag
node_modules/

# Always include these:
!out/
!package.json
!syntaxes/
!LICENSE
