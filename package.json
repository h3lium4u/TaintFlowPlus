{
  "name": "veribuild",
  "version": "1.0.0",
  "description": "",
  "main": "out/extension.js",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onCommand:veribuild.verifyCurrentFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "veribuild.verifyCurrentFile",
        "title": "VeriBuild: Verify Current File"
      },
      {
        "command": "veribuild.configureGroq",
        "title": "VeriBuild: Configure Groq Key"
      }
    ]
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.17.0",
    "chokidar": "^5.0.0",
    "groq-sdk": "^1.2.1"
  }
}
